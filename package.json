{
  "name": "@private/openspec",
  "version": "1.15.0",
  "description": "Private spec-driven development skills and review workflow",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "openspec": "./bin/openspec.js"
  },
  "files": [
    "dist",
    "bin",
    "schemas",
    "!dist/**/*.test.js",
    "!dist/**/__tests__",
    "!dist/**/*.map"
  ],
  "scripts": {
    "lint": "eslint src/",
    "build": "node build.js",
    "generate:skills": "node scripts/generate-skillssh.mjs",
    "regen:parity-hashes": "node scripts/regen-parity-hashes.mjs",
    "dev": "tsc --watch",
    "dev:cli": "pnpm build && node bin/openspec.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prepare": "node build.js",
    "pack:local": "node scripts/pack-local.mjs",
    "check": "npm run build && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "@vitest/ui": "^4.1.12",
    "eslint": "^10.5.0",
    "smol-toml": "^1.7.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@inquirer/core": "^12.0.0",
    "@inquirer/prompts": "^8.5.2",
    "brace-expansion": "^5.0.12",
    "chalk": "^5.6.2",
    "commander": "^14.0.0",
    "cross-spawn": "7.0.6",
    "diff": "^9.0.0",
    "ora": "^9.4.1",
    "picomatch": "^4.0.4",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  },
  "private": true
}
